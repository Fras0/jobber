generator client {
    provider = "prisma-client-js"
    // output   = "../../../node_modules/@prisma-clients/jobber-auth"
    output   = "../src/prisma/generated"
}

datasource db {
    provider = "postgresql"
}

model User {
    id       Int    @id @default(autoincrement())
    email    String @unique
    password String
}
